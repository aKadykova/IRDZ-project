---
import LandingBlocks from '../components/LandingBlocks.astro';
import Layout from '../layouts/Layout.astro';
import type { TPageResponse } from '../types';

const baseApiUrl = import.meta.env.PUBLIC_STRAPI_URL ?? 'http://localhost:1337';
const response = await fetch(new URL('/api/landing-page', baseApiUrl));

if (!response.ok) {
    throw new Error(`Landing page request failed: ${response.status}`);
}

const landingPage = (await response.json()) as TPageResponse;
---

<Layout>
    <LandingBlocks blocks={landingPage.data.blocks} />
</Layout>
