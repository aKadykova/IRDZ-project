---
import type { TPageLink } from '../types';

interface Props {
  data: TPageLink;
}

const { data } = Astro.props;
---

<a class="section-link" href={data.href}>{data.label}</a>

<style>
  .section-link {
    font-family: 'Manrope', sans-serif;
    display: inline-block;
    margin-top: 50px;
    font-size: 30px;
    color: var(--color-section-link);
    font-weight: 350;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .section-link:hover {
    opacity: 0.72;
  }
</style>
