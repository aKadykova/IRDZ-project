---
import type { TThinkingBlock } from '../types';

interface Props {
  data: TThinkingBlock;
}

const { data } = Astro.props;
const description = data.description?.replace(/^#\s*/, '') ?? '';
---

<section class="thinking-section">
  <div class="section-inner">
    <p class="eyebrow">{data.title}</p>
    {description && <h2>{description}</h2>}
    {data.fullDescription && <p class="description">{data.fullDescription}</p>}
  </div>
</section>

<style>
  .thinking-section {
    padding: 112px 40px;
    background: #f4f1eb;
    color: #1e1e22;
  }

  .section-inner {
    width: min(100%, 1160px);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: #6e42d9;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.1;
    font-weight: 700;
  }

  .description {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .thinking-section {
      padding: 72px 24px;
    }
  }
</style>
