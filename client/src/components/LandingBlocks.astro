---
import CardGrid from './CardGrid.astro';
import HeroSection from './HeroSection.astro';
import ListingSection from './ListingSection.astro';
import ThinkingSection from './ThinkingSection.astro';
import type { TLandingBlock } from '../types';

interface Props {
  blocks: TLandingBlock[];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => {
  if (block.__component === 'blocks.hero') {
    return <HeroSection data={block} />;
  }

  if (block.__component === 'blocks.card-grid') {
    return <CardGrid data={block} />;
  }

  if (block.__component === 'blocks.heading-section') {
    return block.target === 'projects' ? <ListingSection data={block} /> : null;
  }

//  if (block.__component === 'blocks.jak-premyslime-section') {
//    return <ThinkingSection data={block} />;
//  }

  return null;
})}
