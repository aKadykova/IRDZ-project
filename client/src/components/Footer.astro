---
import type { TFooterData } from '../types';

interface Props {
  data?: TFooterData;
}

const { data } = Astro.props;

const logo = data?.logo?.[0];
const logoText = logo?.label || 'IRDZ';
const logoHref = logo?.href || '/';
const logoImageUrl = logo?.image?.url;

const columns = data?.column?.length ? data.column : [];

const bottomLinks = data?.bottomLinks?.length ? data.bottomLinks : [];

const copyrightText = data?.copyrightText || '© 2026 IRDZ. Všechna práva vyhrazena.';
---

<footer class="site-footer">
  <div class="footer-container">
    
    <div class="footer-main">
      

      <div class="brand-column">
        <a href={logoHref} class="logo">
          {logoImageUrl ? (
            <img src={logoImageUrl} alt={logoText} class="logo-img" />
          ) : (
            <span>{logoText}</span>
          )}
        </a>

        <div class="address-info">
          {data?.address?.length ? (
            data.address.map((p) => (
              <p>{p.children.map((c) => c.text).join('')}</p>
            ))
          ) : []}
        </div>
      </div>

      <div class="nav-columns">
        {columns.map((col) => (
          <div class="nav-column">
            <h4 class="column-title">{col.title}</h4>
            <ul class="column-links">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>

    <div class="divider"></div>

    <div class="footer-bottom">
      <div class="bottom-links">
        {bottomLinks.map((link) => (
          <a href={link.href} class="bottom-link">
            {link.label}
          </a>
        ))}
      </div>

      <p class="copyright">{copyrightText}</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background-color: var(--color-footer-background);
    color: var(--color-text-light);
    font-family: inherit;
    padding: 60px 0 40px;
  }

  .footer-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }


  .footer-main {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  .brand-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .logo {
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--color-text-light);
    font-size: 48px;
    font-weight: 800;
    text-decoration: none;
    line-height: 1;
  }

  .logo-img {
    align-self: center;
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .address-info {
    text-align: center;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    opacity: 0.9;
  }

  .nav-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .column-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-light);
    margin-bottom: 20px;
    text-align: center;
    line-height: 1.3;
    font-family: inherit; 
  }

  .column-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 14px;
  }

  .footer-link {
    color: var(--color-text-light);
    font-size: 14px;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-divider);
    margin-bottom: 30px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .bottom-link {
    color: var(--color-text-white);
    font-size: 13px;
    font-weight: 300;
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .bottom-link:hover {
    opacity: 1;
  }

  .copyright {
    color: var(--color-text-white);
    font-size: 14px;
    opacity: 0.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .nav-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .nav-columns {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .bottom-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
