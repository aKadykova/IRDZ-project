{
  "kind": "collectionType",
  "collectionName": "innovation_platforms",
  "info": {
    "singularName": "innovation-platform",
    "pluralName": "innovation-platforms",
    "displayName": "Innovation platforms"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "cover_photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "purpose": {
      "type": "text"
    },
    "goals": {
      "type": "text"
    },
    "reason_for_creation": {
      "type": "text"
    },
    "people_organisations_involved": {
      "type": "text"
    },
    "ways_to_get_involved": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "show_on_homepage": {
      "type": "boolean",
      "default": false
    },
    "homepage_order": {
      "type": "integer",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "show_on_homepage"
            },
            true
          ]
        }
      },
      "default": 0,
      "min": 0,
      "max": 5
    },
    "curren_status": {
      "type": "enumeration",
      "enum": [
        "Příprava",
        "Pilotáž",
        "Vyhodnocení",
        "Dokončeno"
      ]
    },
    "tag_areas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-area.tag-area",
      "inversedBy": "innovation_platforms"
    },
    "target_groups": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-target-group.tag-target-group",
      "inversedBy": "innovation_platforms"
    },
    "public_contact": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::team-member.team-member",
      "inversedBy": "contact_platforms"
    },
    "team_members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::team-member.team-member",
      "inversedBy": "platforms"
    },
    "current_activities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-activity.tag-activity",
      "inversedBy": "innovation_platforms"
    }
  }
}
