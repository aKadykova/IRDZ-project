{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Members"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "profileSlug": {
      "type": "uid",
      "targetField": "fullName",
      "required": true
    },
    "jobTitle": {
      "type": "string",
      "required": true
    },
    "academicTitle": {
      "type": "string"
    },
    "professionalFocus": {
      "type": "text",
      "required": true
    },
    "bioDescription": {
      "type": "blocks"
    },
    "experience": {
      "type": "text"
    },
    "professionalProfileUrl": {
      "type": "string"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "email": {
      "type": "email",
      "required": false,
      "unique": true
    },
    "showOnHomepage": {
      "type": "boolean",
      "default": false
    },
    "homepageOrder": {
      "type": "integer",
      "default": 0
    },
    "is_public_contact": {
      "type": "boolean",
      "default": false
    },
    "contact_projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "is_public_contact"
            },
            true
          ]
        }
      },
      "mappedBy": "public_contact"
    },
    "contact_platforms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::innovation-platform.innovation-platform",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "is_public_contact"
            },
            true
          ]
        }
      },
      "mappedBy": "public_contact"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "team_members"
    },
    "platforms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::innovation-platform.innovation-platform",
      "mappedBy": "team_members"
    }
  }
}
